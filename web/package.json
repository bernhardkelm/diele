{
  "name": "@diele/web",
  "version": "0.1.1",
  "private": true,
  "description": "The diele launcher: a new tab page for everything you self-host.",
  "license": "AGPL-3.0-or-later",
  "author": "Bernhard Kelm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernhardkelm/diele.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/bernhardkelm/diele/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "oxlint . && eslint .",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@diele/common": "*",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "~1.77.0",
    "postcss-custom-media": "^12.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=24.7"
  }
}
