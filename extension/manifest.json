{
  "manifest_version": 3,
  "name": "diele new tab",
  "description": "Opens your diele instance instead of the browser's new tab page.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
