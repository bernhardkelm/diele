{
  "manifest_version": 3,
  "name": "diele new tab",
  "description": "Opens your diele instance instead of the browser's new tab page, switches between several, and can send the pages you visit to one.",
  "version": "1.2.0",
  "permissions": ["storage"],
  "optional_permissions": ["webNavigation", "tabs", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "storage.js",
      "history/keys.js",
      "history/hosts.js",
      "history/tokens.js",
      "history/searchPages.js",
      "history/filter.js",
      "history/scope.js",
      "history/buffer.js",
      "history/state.js",
      "history/store.js",
      "history/nudge.js",
      "history/capture.js",
      "history/target.js",
      "history/messages.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "diele instances",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "diele-new-tab@bernhardkelm.de",
      "strict_min_version": "128.0"
    }
  }
}
