# Every variable diele reads, with the default it runs on. This file is committed, and it is the
# authoritative list: `api/.env` and `web/.env` exist only as override slots and ship with
# everything commented out, so nothing here is shadowed unless someone deliberately does it.
#
# Never put a secret or a machine-specific value in here. Those go in `.env.local`, which is
# gitignored - copy `.env.local.example` to start one, and see it for the precedence order.

# ── the two halves ────────────────────────────────────────────────────────────────────────────

# [api] Port the api listens on.
PORT=3000

# [web] Where the dev server proxies /api. Development only: a build talks to whatever origin
# serves it. Must match PORT above.
VITE_API_TARGET=http://localhost:3000

# [api] Origin the browser reaches diele on. Locally that is the vite dev server, which proxies
# /api to the api process, so both halves stay same-origin and the session cookie is first-party.
# The OIDC redirect uri is derived from this.
PUBLIC_ORIGIN=http://localhost:5173

# ── storage ───────────────────────────────────────────────────────────────────────────────────

# [api] Created and migrated on boot; delete the file to start over. A relative path is resolved
# from the repo root, so the database lands in ./data/ whichever directory npm ran from.
DB_PATH="data/diele.db"

# ── sign-in ───────────────────────────────────────────────────────────────────────────────────

# [api] `local` keeps accounts in this database and signs them in with a password, which is what
# an instance without an issuer wants and what a first run should be. The first account is
# created through a setup form gated by a token the server prints at startup, so an unclaimed
# instance is not an open one.
#
# `oidc` runs the real authorization code flow against any compliant issuer, and `dev` grants
# every login as a fixed local identity. Both need values that do not belong in a committed
# file, so they live in `.env.local`. A misspelled mode falls back here and says so on stderr.
AUTH_MODE=local

# [api] How long a session may sit unused. Both windows roll forward on every use, so these are
# idle time rather than lifetime: an instance opened daily never asks again. The second is what
# `remember me` picks at login.
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=7776000000

# [api] Defaults to on when PUBLIC_ORIGIN is https and off otherwise, which is almost always
# right. Set it explicitly only to override that: a secure cookie sent to an http origin is
# dropped by the browser without a word, and the login then answers 200 while staying signed out.
SESSION_COOKIE_SECURE=auto

# ── seeding ───────────────────────────────────────────────────────────────────────────────────

# [api] Whether a database created by this boot gets the search engines, slash commands and local
# ports every portal would hold anyway, most of them switched off. Read only while the schema is
# created, so turning it off later changes nothing that is already there. Cards and saved sites
# are never seeded; those are guesses at addresses only one deployment knows.
DIELE_SEED_STOCK_CONFIG="true"

# ── appearance ────────────────────────────────────────────────────────────────────────────────

# [api] The wordmark and the line under it. The subtitle is uppercased and letter-spaced by the
# web app, so write it in ordinary case.
BRAND_TITLE="diele"
BRAND_SUBTITLE="start page"

# [api] The accent: the tilde in the wordmark, and every hover and focus state. One value per
# theme, six-digit hex only.
BRAND_ACCENT_LIGHT="#16a34a"
BRAND_ACCENT_DARK="#22c55e"
