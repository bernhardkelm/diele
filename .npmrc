; eslint-plugin-oxlint peer-pins oxlint to its own minor, but the plugin always
; publishes a bit behind oxlint. Renovate bumps oxlint ahead, so `npm ci` hits a
; transient peer ERESOLVE until the plugin catches up. Tolerate it - the group
; rule realigns both to the same minor once the plugin publishes.
legacy-peer-deps=true
