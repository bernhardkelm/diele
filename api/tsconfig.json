// Solution file, the same shape `web` uses. It compiles nothing itself: it exists so an editor
// opening a file under `tests/` finds the project that covers it, since tsserver only discovers
// configs named `tsconfig.json` and whatever they reference.
{
  "files": [],
  "references": [{ "path": "./tsconfig.build.json" }, { "path": "./tsconfig.test.json" }]
}
