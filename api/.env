# Override slot for the api, and this file is committed.
#
# Everything is commented out on purpose. The authoritative defaults live in the repo-wide
# `../.env`, which lists every variable; this file is more specific and therefore outranks it,
# so anything uncommented here silently wins over the value someone will go and edit up there.
# Uncomment only what genuinely belongs to this package alone.
#
# Never put a secret in here - those go in `api/.env.local` or the repo-wide `.env.local`, both
# gitignored. See `../.env.local.example` for the precedence order and every variable's default.

#PORT=3000
#PUBLIC_ORIGIN=http://localhost:5173
#DB_PATH="data/diele.db"

#AUTH_MODE=local
#SESSION_MAX_AGE_MS=86400000
#SESSION_REMEMBER_MAX_AGE_MS=7776000000
#SESSION_COOKIE_SECURE=false

#BRAND_TITLE="diele"
#BRAND_SUBTITLE="start page"
#BRAND_ACCENT_LIGHT="#16a34a"
#BRAND_ACCENT_DARK="#22c55e"
